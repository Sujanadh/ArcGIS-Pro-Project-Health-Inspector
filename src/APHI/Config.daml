<?xml version="1.0" encoding="utf-8" ?>
<ArcGIS defaultAssembly="APHI.dll" defaultNamespace="APHI" xmlns="http://schemas.esri.com/DADF/Registry" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://schemas.esri.com/DADF/Registry file:///C:/Program%20Files/ArcGIS/Pro/bin/ArcGIS.Desktop.Framework.xsd">
  <AddInInfo id="{3b1e7c9f-3d61-4c12-a7f9-2b0e3b9f4a12}" version="1.0.0" desktopVersion="3.3.0">
    <Name>Project Health Inspector</Name>
    <Description>Analyzes ArcGIS Pro projects for performance, best practices, and data integrity issues.</Description>
    <Image>Images\HealthInspector32.png</Image>
    <Author>Sujan</Author>
    <Company>Sujan</Company>
    <Date>2026-08-04</Date>
    <Subject>Framework</Subject>
  </AddInInfo>

  <modules>
    <insertModule id="APHI_Module" className="Module1" autoLoad="false" caption="Project Health Inspector">
      <tabs>
        <tab id="APHI_Tab" caption="Health Inspector">
          <group refID="APHI_MainGroup" />
        </tab>
      </tabs>
      
      <groups>
        <group id="APHI_MainGroup" caption="Project Health" appearsOnAddInTab="false">
          <button refID="APHI_OpenInspectorButton" size="large" />
          <button refID="APHI_RunScanButton" size="middle" />
          <button refID="APHI_ExportReportButton" size="middle" />
          <button refID="APHI_OpenSettingsButton" size="middle" />
        </group>
      </groups>
      
      <controls>
        <button id="APHI_OpenInspectorButton" caption="Open Inspector" className="OpenInspectorButton" loadOnClick="true" smallImage="Images\HealthInspector16.png" largeImage="Images\HealthInspector32.png">
          <tooltip heading="Open Inspector">Opens the Project Health Inspector pane.</tooltip>
        </button>
        <button id="APHI_RunScanButton" caption="Run Scan" className="RunScanButton" loadOnClick="true" smallImage="Images\HealthInspector16.png">
          <tooltip heading="Run Scan">Starts a health scan of the current project.</tooltip>
        </button>
        <button id="APHI_ExportReportButton" caption="Export Report" className="ExportReportButton" loadOnClick="true" smallImage="Images\HealthInspector16.png">
          <tooltip heading="Export Report">Exports the last scan results to a report.</tooltip>
        </button>
        <button id="APHI_OpenSettingsButton" caption="Settings" className="OpenSettingsButton" loadOnClick="true" smallImage="Images\HealthInspector16.png">
          <tooltip heading="Settings">Configures the Project Health Inspector settings.</tooltip>
        </button>
      </controls>

      <dockPanes>
        <dockPane id="APHI_InspectorDockpane" caption="Project Health Inspector" className="InspectorDockpane" dock="group" dockWith="esri_core_projectDockPane">
          <content className="InspectorDockpaneView" />
        </dockPane>
      </dockPanes>
    </insertModule>
  </modules>
</ArcGIS>
