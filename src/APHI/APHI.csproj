<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <OutputType>Library</OutputType>
    <RootNamespace>APHI</RootNamespace>
    <AssemblyName>APHI</AssemblyName>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AssemblyVersion>1.0.3.0</AssemblyVersion>
    <FileVersion>1.0.3.0</FileVersion>
    <Version>1.0.3</Version>
    <Authors>APHI Contributors</Authors>
    <Company>APHI</Company>
    <Product>ArcGIS Pro Project Health Inspector</Product>
    <Description>Grammarly for ArcGIS Pro Projects — Comprehensive health analysis, scoring, and auto-fix for .aprx projects.</Description>
    <Copyright>Copyright © 2024-2026 APHI Contributors</Copyright>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Esri.ArcGISPro.Extensions30" Version="3.3.*">
      <ExcludeAssets>build</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <None Update="Config.daml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Images\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- 
    Post-build: Package the add-in as .esriAddinX
    An .esriAddinX is a ZIP archive containing:
      - Config.daml (the add-in manifest)
      - APHI.dll (the compiled assembly)
      - Image resources
      - Any other required runtime files
    The archive is created in the output directory.
  -->
  <Target Name="PackageAddin" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <PropertyGroup>
      <AddinFileName>ProjectHealthInspector.esriAddinX</AddinFileName>
      <AddinOutputPath>$(TargetDir)..\$(AddinFileName)</AddinOutputPath>
    </PropertyGroup>
    <Delete Files="$(AddinOutputPath)" Condition="Exists('$(AddinOutputPath)')" />
    <ZipDirectory SourceDirectory="$(OutputPath)" DestinationFile="$(AddinOutputPath)" Overwrite="true" />
    <Message Importance="high" Text="Add-in packaged: $(AddinOutputPath)" />
  </Target>

</Project>
