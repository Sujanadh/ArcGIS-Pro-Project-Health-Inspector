<Window x:Class="APHI.UI.AutoFixPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Auto-Fix Preview" Height="500" Width="700"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Warning Banner -->
        <Border Grid.Row="0" Background="#FFF3CD" BorderBrush="#FFEEBA" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,10">
            <TextBlock Text="Warning: Auto-fix will modify your project. Please ensure you have a backup before proceeding." Foreground="#856404" FontWeight="SemiBold" TextWrapping="Wrap"/>
        </Border>

        <!-- Fixes List -->
        <ListView Grid.Row="1" ItemsSource="{Binding ProposedFixes}" SelectedItem="{Binding SelectedFix}">
            <ListView.View>
                <GridView>
                    <GridViewColumn>
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsSelected}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Issue" DisplayMemberBinding="{Binding Title}" Width="250"/>
                    <GridViewColumn Header="Suggested Fix" DisplayMemberBinding="{Binding SuggestedFix}" Width="350"/>
                </GridView>
            </ListView.View>
        </ListView>

        <ProgressBar Grid.Row="2" Height="10" Margin="0,10,0,0" Value="{Binding FixProgress}" Visibility="{Binding IsApplying}" />

        <!-- Buttons -->
        <DockPanel Grid.Row="3" Margin="0,10,0,0">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                <Button Content="Select All" Command="{Binding SelectAllCommand}" Width="80" Margin="0,0,5,0" />
                <Button Content="Deselect All" Command="{Binding DeselectAllCommand}" Width="80" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Apply Selected" Command="{Binding ApplyCommand}" Width="100" Margin="0,0,5,0" />
                <Button Content="Cancel" Command="{Binding CancelCommand}" Width="75" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
